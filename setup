#!/usr/bin/env bash
# Locate the repository directory robustly: resolve a possible symlink
# chain first (the global launcher on PATH is a symlink into the repo),
# so this command works from any working directory. Direct `./setup`
# invocation behaves exactly as before.
SETUP_SELF="$0"
SETUP_DEPTH=0
while [[ -L "$SETUP_SELF" && "$SETUP_DEPTH" -lt 20 ]]; do
  SETUP_LINK_DIR="$(cd -P "$(dirname "$SETUP_SELF")" 2>/dev/null && pwd)" || break
  SETUP_TARGET="$(readlink "$SETUP_SELF" 2>/dev/null)" || break
  case "$SETUP_TARGET" in
    /*) SETUP_SELF="$SETUP_TARGET";;
    *) SETUP_SELF="$SETUP_LINK_DIR/$SETUP_TARGET";;
  esac
  SETUP_DEPTH=$((SETUP_DEPTH + 1))
done
cd -P "$(dirname "$SETUP_SELF")" 2>/dev/null || { echo "[$0]: cannot locate repository directory" >&2; exit 1; }
# Display name for help and examples: the plain name users typed.
# Unchanged for direct `./setup` use.
case "$(basename -- "$0")" in
  setup) SETUP_CMD_NAME="./setup";;
  *) SETUP_CMD_NAME="$(basename -- "$0")";;
esac
export SETUP_CMD_NAME
# Use REPO_ROOT instead of base - when scripts are sourced they do not need export to inherit vars
REPO_ROOT="$(pwd)"
source ./sdata/lib/environment-variables.sh
source ./sdata/lib/functions.sh
source ./sdata/lib/package-installers.sh
source ./sdata/lib/dist-determine.sh

# Plain output when styling would only add noise: piped/logged output,
# NO_COLOR, or terminals without color support. Interactive color terminals
# keep the styled interface below.
if [[ -n "${NO_COLOR:-}" || "${TERM:-}" == "dumb" ]] || ! [[ -t 1 ]]; then
  STY_RED= STY_GREEN= STY_YELLOW= STY_BLUE= STY_PURPLE= STY_CYAN=
  STY_BOLD= STY_FAINT= STY_SLANT= STY_UNDERLINE= STY_BLINK= STY_INVERT= STY_RST=
fi

prevent_sudo_or_root
set -e

#####################################################################################
showhelp_global(){
printf "${STY_BOLD}illogical-impulse setup${STY_RST}
${STY_FAINT}Fork-managed workstation config. Most days, one command is enough.${STY_RST}

  ${STY_BOLD}${SETUP_CMD_NAME} update${STY_RST}               Bring this machine to the latest fork revision.
  ${STY_BOLD}${SETUP_CMD_NAME} update --dry-run${STY_RST}    Preview what an update would change.

  ${SETUP_CMD_NAME} install              First-time install, or repair this machine.
  ${SETUP_CMD_NAME} commands             Every command, grouped by purpose.
  ${SETUP_CMD_NAME} <command> --help     Flags and examples for one command.

${STY_FAINT}Docs: https://ii.clsty.link${STY_RST}
"
}
case $1 in
  # Global help
  ""|help|--help|-h)showhelp_global;exit;;
  # Correct subcommand
  install|uninstall|exp-update|exp-merge|adopt|plan|decide|apply|update|commands|resetfirstrun|checkdeps|virtmon)
    SUBCMD_NAME=$1
    SUBCMD_DIR=./sdata/subcmd-$1
    shift;;
  # Correct subcommand but not using ./sdata/subcmd-$1
  install-deps|install-setups|install-files)
    SUBCMD_NAME=$1
    SUBCMD_DIR=./sdata/subcmd-install
    shift;;
  # Wrong subcommand
  *)printf "${STY_RED}Unknown subcommand \"$1\".${STY_RST}\n";showhelp_global;exit 1;;
esac
#####################################################################################
if [[ -f "${SUBCMD_DIR}/options.sh" ]];
  then source "${SUBCMD_DIR}/options.sh"
fi
case ${SUBCMD_NAME} in
  install)
    for function in ${print_os_group_id_functions[@]}; do
      $function
    done
    pause
    # Initialize sudo keepalive for the entire install process
    sudo_init_keepalive
    # Set trap to cleanup when this subcommand exits
    trap sudo_stop_keepalive EXIT INT TERM
    if [[ "${SKIP_ALLGREETING}" != true ]]; then
      source ${SUBCMD_DIR}/0.greeting.sh
    fi
    if [[ "${SKIP_ALLDEPS}" != true ]]; then
      source ${SUBCMD_DIR}/1.deps-router.sh
    fi
    if [[ "${SKIP_ALLSETUPS}" != true ]]; then
      source ${SUBCMD_DIR}/2.setups.sh
    fi
    if [[ "${SKIP_ALLFILES}" != true ]]; then
      source ${SUBCMD_DIR}/3.files.sh
    fi
    ;;
  install-deps)
    for function in ${print_os_group_id_functions[@]}; do
      $function
    done
    pause
    # Initialize sudo keepalive for dependency installation
    sudo_init_keepalive
    # Set trap to cleanup when this subcommand exits
    trap sudo_stop_keepalive EXIT INT TERM
    if [[ "${SKIP_ALLDEPS}" != true ]]; then
      source ${SUBCMD_DIR}/1.deps-router.sh
    fi
    ;;
  install-setups)
    for function in ${print_os_group_id_functions[@]}; do
      $function
    done
    pause
    # Initialize sudo keepalive for setup steps
    sudo_init_keepalive
    # Set trap to cleanup when this subcommand exits
    trap sudo_stop_keepalive EXIT INT TERM
    if [[ "${SKIP_ALLSETUPS}" != true ]]; then
      source ${SUBCMD_DIR}/2.setups.sh
    fi
    ;;
  install-files)
    for function in ${print_os_group_id_functions[@]}; do
      $function
    done
    pause
    if [[ "${SKIP_ALLFILES}" != true ]]; then
      source ${SUBCMD_DIR}/3.files.sh
    fi
    ;;
  *)
    source ${SUBCMD_DIR}/0.run.sh
    exit
    ;;
esac
