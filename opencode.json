{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": {
      "~/.config/**": "deny",
      "~/.local/**": "deny",
      "/etc/**": "deny"
    },
    "bash": {
      "*": "ask",
      "sudo *": "ask",
      "su *": "ask",
      "doas *": "ask",
      "pacman *": "ask",
      "yay *": "ask",
      "paru *": "ask",
      "apt *": "ask",
      "apt-get *": "ask",
      "dnf *": "ask",
      "zypper *": "ask",
      "emerge *": "ask",
      "nix-env *": "ask",
      "flatpak *": "ask",
      "snap *": "ask",
      "systemctl *": "ask",
      "loginctl *": "ask",
      "service *": "ask",
      "git *": "ask",
      "git commit*": "ask",
      "git push*": "ask",
      "git pull*": "ask",
      "git fetch*": "ask",
      "git clone*": "ask",
      "git checkout*": "ask",
      "git switch*": "ask",
      "git restore*": "ask",
      "git reset*": "ask",
      "git rebase*": "ask",
      "git merge*": "ask",
      "git cherry-pick*": "ask",
      "git revert*": "ask",
      "git stash*": "ask",
      "git clean*": "ask",
      "git rm*": "ask",
      "git mv*": "ask",
      "git tag*": "ask",
      "git worktree*": "ask",
      "git submodule*": "ask",
      "gh *": "ask",
      "hyprctl *": "ask",
      "./setup*": "ask",
      "sdata/*": "ask",
      "./sdata/*": "ask",
      "rm *": "ask",
      "rm -rf *": "ask",
      "rm -r *": "ask",
      "rm -f *": "ask",
      "rmdir *": "ask",
      "chmod *": "ask",
      "chown *": "ask",
      "mv *": "ask",
      "cp *": "ask",
      "ln *": "ask",
      "tee *": "ask",
      "dd *": "ask",
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git show*": "allow",
      "git rev-parse*": "allow",
      "git remote*": "allow",
      "git branch*": "allow",
      "git ls-files*": "allow",
      "git ls-tree*": "allow",
      "git cat-file*": "allow",
      "git blame*": "allow",
      "git grep*": "allow",
      "git describe*": "allow",
      "git tag --list*": "allow",
      "git tag -l*": "allow",
      "git stash list*": "allow",
      "git worktree list*": "allow",
      "git submodule status*": "allow",
      "ls*": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "stat *": "allow",
      "file *": "allow",
      "readlink *": "allow",
      "realpath *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "find *-delete*": "ask",
      "find *-exec*": "ask",
      "fd *": "allow",
      "diff *": "allow",
      "jq *": "allow",
      "pwd*": "allow",
      "uname*": "allow",
      "whoami*": "allow",
      "bash -n *": "allow",
      "shellcheck *": "allow",
      "sh -n *": "allow",
      "fish -n *": "allow",
      "python3 -m py_compile *": "allow",
      "python3 -m compileall *": "allow",
      "luac -p *": "allow",
      "luacheck *": "allow",
      "yamllint *": "allow",
      "./diagnose*": "allow",
      "hyprctl --help*": "allow",
      "hyprctl -h*": "allow",
      "hyprctl version*": "allow",
      "hyprctl monitors*": "allow",
      "hyprctl workspaces*": "allow",
      "hyprctl clients*": "allow",
      "hyprctl binds*": "allow",
      "hyprctl devices*": "allow",
      "hyprctl layers*": "allow",
      "hyprctl getoption*": "allow",
      "hyprctl systeminfo*": "allow",
      "hyprctl cursorpos*": "allow"
    },
    "external_directory": {
      "~/.config/**": "allow",
      "~/.local/**": "allow",
      "~/ii-original-dots-backup/**": "allow",
      "/etc/os-release": "allow"
    }
  }
}
