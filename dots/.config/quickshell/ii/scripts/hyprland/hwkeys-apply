# Stock keycode binds live here (keybinds.lua workspace/numpad/zoom twins);
# refusing them keeps a hardware mapping from stealing a working shortcut.
RESERVED_CODES = set(list(range(10, 20)) + list(range(79, 91)) + [82, 86])

ID_RE = re.compile(r"^[A-Za-z0-9_-]{1,64}$")


def config_path():
    xdg = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    return os.path.join(xdg, "illogical-impulse", "config.json")


def output_path():
    return os.path.join(os.path.expanduser("~"), ".config", "hypr", "custom", "hwkeys-generated.lua")


def lua_escape(value):
    return value.replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n")


def fail(message):
    print(f"hwkeys-apply: error: {message}", file=sys.stderr)
    return 2


def read_intent(overrides=None):
    try:
        with open(config_path(), "r", encoding="utf-8") as handle:
            data = json.load(handle)
    except FileNotFoundError:
        data = {}
    except (json.JSONDecodeError, OSError) as exc:
        return None, f"unreadable config.json: {exc}"
    section = data.get("hardwareKeys", {})
    if not isinstance(section, dict):
        return None, "config hardwareKeys section is not an object"
    version = section.get("version", SCHEMA_VERSION)
    if version != SCHEMA_VERSION:
        return None, f"unsupported hardwareKeys schema version {version!r}"
    bindings = section.get("bindings", [])
    if not isinstance(bindings, list):
        return None, "hardwareKeys bindings is not a list"
    if overrides is not None:
        bindings = overrides
    intent = {"version": version, "bindings": bindings}
    return intent, ""


def validate(intent):
    bindings = intent["bindings"]
    if not isinstance(bindings, list):
        return "bindings is not a list"
    seen = set()
    for i, b in enumerate(bindings):
        if not isinstance(b, dict):
            return f"binding #{i} is not an object"
        if not isinstance(b.get("id"), str) or not ID_RE.match(b["id"]):
            return f"binding #{i} has a bad id"
        code = b.get("code")
        if not isinstance(code, int) or isinstance(code, bool) or not 8 <= code <= 1024:
            return f"binding #{i} has a bad keycode"
        if code in RESERVED_CODES:
            return f"keycode {code} is already used by End-4 shortcuts"
        if code in seen:
            return f"keycode {code} is assigned twice"
        seen.add(code)
        action = b.get("action")
        if action not in ACTIONS:
            return f"binding #{i} has an unknown action"
        if action == "custom":
            cmd = b.get("command", "")
            if not isinstance(cmd, str) or not cmd.strip() or "\n" in cmd or "\r" in cmd:
                return f"binding #{i} needs a one-line custom command"
            if len(cmd) > 2000:
                return f"binding #{i} custom command is too long"
        if not isinstance(b.get("enabled", True), bool):
            return f"binding #{i} has a bad enabled flag"
    return ""


def render(intent):
    lines = [
        MARKER,
        f"-- source: {json.dumps(intent, sort_keys=True)}",
        "",
        "local qsIpcCall = \"qs -c $qsConfig ipc call\"",
        "local grimhyprctl = \"grim -o \\\"$(hyprctl activeworkspace -j | jq -r '.monitor')\\\"\"",
        "",
    ]
    for b in intent["bindings"]:
        if not b.get("enabled", True):
            continue
        action = ACTIONS[b["action"]]
        flags = action["flags"]
        if "global" in action:
            lines.append(
                f'hl.bind("code:{b["code"]}", hl.dsp.global("{action["global"]}"), '
                f'{{ description = "{action["desc"]}"{flags} }})'
            )
            continue
        cmd = f'"{lua_escape(b["command"].strip())}"' if b["action"] == "custom" else action["cmd"]
        lines.append(
            f'hl.bind("code:{b["code"]}", hl.dsp.exec_cmd({cmd}), '
            f'{{ description = "{action["desc"]}"{flags} }})'
        )
    lines.append("")
    return "\n".join(lines)


def is_ours(path):
    try:
        with open(path, "r", encoding="utf-8") as handle:
            return handle.readline().strip() == MARKER
    except OSError:
        return False


def check_state(intent, problem):
    if problem:
        return 2, problem
    if intent is None:
        return 2, problem
    path = output_path()
    active = [b for b in intent["bindings"] if b.get("enabled", True)]
    if not active:
        if os.path.exists(path) and is_ours(path):
            return 1, "generated file present without active mappings"
        return 0, "no active mappings, no generated file"
    try:
        with open(path, "r", encoding="utf-8") as handle:
            current = handle.read()
    except OSError:
        return 1, "generated file missing"
    if current != render(intent):
        return 1, "generated file stale"
    return 0, "generated file in sync"


def apply_state(intent, problem):
    if problem or intent is None:
        return fail(problem or "no intent readable")
    path = output_path()
    active = [b for b in intent["bindings"] if b.get("enabled", True)]
    if not active:
        if os.path.exists(path):
            if not is_ours(path):
                return fail(f"refusing to remove hand-made {path}")
            os.remove(path)
            print("removed generated file (no active mappings)")
        else:
            print("no active mappings, nothing to do")
        return 0
    content = render(intent)
    if os.path.exists(path):
        if not is_ours(path):
            return fail(f"refusing to overwrite hand-made {path}")
        with open(path, "r", encoding="utf-8") as handle:
            if handle.read() == content:
                print("generated file already in sync")
                return 0
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with tempfile.NamedTemporaryFile(mode="w", dir=os.path.dirname(path), delete=False) as tmp:
        tmp.write(content)
        tmp_path = tmp.name
    os.chmod(tmp_path, 0o644)
    os.replace(tmp_path, path)
    print(f"wrote {path}")
    return 0


def main(argv):
    parser = argparse.ArgumentParser(description="Apply hardware-key mappings to Hyprland.")
    parser.add_argument("--apply", action="store_true", help="write/remove generated file to match intent")
    parser.add_argument("--check", action="store_true", help="exit 0 in sync, 1 stale/missing, 2 invalid")
    parser.add_argument("--catalog", action="store_true", help="print the action catalog as JSON")
    parser.add_argument("--bindings-json", default=None, help="use this bindings list instead of the file value")
    args = parser.parse_args(argv)
    if args.catalog:
        print(json.dumps([
            {"id": k, "label": v["label"], "hint": v["hint"],
             "needsCommand": k == "custom", "advanced": k == "custom"}
            for k, v in ACTIONS.items()
        ]))
        return 0
    overrides = None
    if args.bindings_json is not None:
        try:
            overrides = json.loads(args.bindings_json)
        except json.JSONDecodeError as exc:
            return fail(f"bad --bindings-json: {exc}")
    intent, problem = read_intent(overrides)
    if problem and intent is not None:
        return fail(problem)
    if intent is not None:
        problem = validate(intent)
    if args.check:
        if overrides is not None:
            if problem or intent is None:
                return fail(problem or "no intent readable")
            print(f"valid: {len(intent['bindings'])} mapping(s)")
            return 0
        code, message = check_state(intent, problem)
        print(message)
        return code
    return apply_state(intent, problem)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
