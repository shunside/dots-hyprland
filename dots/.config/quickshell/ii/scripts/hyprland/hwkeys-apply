#!/usr/bin/env python3
"""Generate ~/.config/hypr/custom/hwkeys-generated.lua from config.json hardware key mappings.

Slice 2A scope (deliberately narrow): raw `code:` mappings for observable,
unbound hardware keys. No firmware-chord replacement, no device scoping,
no suppression logic.

--catalog prints the action catalog as JSON for the Settings UI.
--bindings-json overrides the file list for one run, so the UI can validate
and apply an exact draft: validate with `--check` + overrides, persist the
same list, apply with `--apply` + the same overrides. config.json stays the
durable canonical intent; boot reconcile (no overrides) converges generated
state to it.
"""

import argparse
import json
import os
import re
import sys
import tempfile

SCHEMA_VERSION = 1
MARKER = "-- Generated by hwkeys-apply. DO NOT EDIT."

# Command strings mirror dots/.config/hypr/hyprland/keybinds.lua verbatim
# ($qsConfig/$HOME expand at dispatch time, as in stock). They live here and
# only here: the generated file cannot require keybinds.lua without
# re-registering stock binds, so one commented copy is the smallest option.
ACTIONS = {
