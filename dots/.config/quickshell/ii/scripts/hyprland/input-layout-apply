#!/usr/bin/env python3
"""Generate ~/.config/hypr/custom/input-generated.lua from config.json input intent.

Phase 1 scope (deliberately narrow):
  - empty layout -> no intent: remove generated file (if ours), succeed
  - "us"         -> keyboard config only, no shortcut transformation
  - "tr"         -> keyboard config plus the verified tr shortcut remediation
  - other single layout -> keyboard config only; shortcut positions unverified

Multi-layout values are rejected: phase 1 defers them. Comma-separated
kb_options for a single layout stay allowed.

--layout/--variant/--options substitute the file values for one run, so a
caller can validate and apply an exact draft without trusting write timing:
validate with `--check` + overrides, persist the same triple, apply with
`--apply` + the same overrides. config.json stays the durable canonical
intent; boot reconcile (no overrides) converges generated state to it.
"""

import argparse
import json
import os
import re
import sys
import tempfile

SCHEMA_VERSION = 1
MARKER = "-- Generated by input-layout-apply. DO NOT EDIT."

LAYOUT_RE = re.compile(r"^[a-z0-9_]+$")
VARIANT_RE = re.compile(r"^[A-Za-z0-9_-]+$")
OPTIONS_RE = re.compile(r"^[A-Za-z0-9_:,+-]+$")


def config_path():
    xdg = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    return os.path.join(xdg, "illogical-impulse", "config.json")


def output_path():
    return os.path.join(os.path.expanduser("~"), ".config", "hypr", "custom", "input-generated.lua")


def lua_escape(value):
    return value.replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n")


def fail(message):
    print(f"input-layout-apply: error: {message}", file=sys.stderr)
    return 2


def read_intent(overrides=None):
    try:
        with open(config_path(), "r", encoding="utf-8") as handle:
            data = json.load(handle)
    except FileNotFoundError:
        data = {}
    except (json.JSONDecodeError, OSError) as exc:
        return None, f"unreadable config.json: {exc}"
    section = data.get("input", {})
    if not isinstance(section, dict):
        return None, "config input section is not an object"
    version = section.get("version", SCHEMA_VERSION)
    if version != SCHEMA_VERSION:
        return None, f"unsupported input schema version {version!r}"
    intent = {
        "layout": str(section.get("layout", "")).strip(),
        "variant": str(section.get("variant", "")).strip(),
        "options": str(section.get("options", "")).strip(),
    }
    if overrides:
        for key in ("layout", "variant", "options"):
            if overrides.get(key) is not None:
                intent[key] = str(overrides[key]).strip()
    return intent, ""


def validate(intent):
    if not intent["layout"]:
        if intent["variant"] or intent["options"]:
            return "variant/options need a layout"
        return ""
    if "," in intent["layout"] or not LAYOUT_RE.match(intent["layout"]):
        if "," in intent["layout"]:
            return "multi-layout (comma-separated layouts) is not supported in phase 1"
        return "layout must look like \"us\" or \"tr\""
    if "," in intent["variant"]:
        return "multi-layout variants are not supported in phase 1"
    if intent["variant"] and not VARIANT_RE.match(intent["variant"]):
        return "variant contains unsupported characters"
    if intent["options"] and not OPTIONS_RE.match(intent["options"]):
        return "options contains unsupported characters"
    return ""


# tr remediation (verified): unbind stock spellings that have no bare Level-1
# producer on tr, and re-emit each action on its natural tr chord so cheatsheet
# and shortcut agree. Shift-produced symbols take SHIFT + bare producer;
# AltGr-produced symbols take MOD5 + bare producer (AltGr presents as Mod5).
# Unbinding "SUPER + Period" is not needed (period is bare on AB10) and is
# therefore absent; same for Minus. Later verified layouts add their own
# audited block; nothing here is generic machinery.
TR_UNBINDS = [
    "SUPER + Slash",
    "SHIFT + SUPER + ALT + Slash",
    "SUPER + Semicolon",
    "SUPER + Apostrophe",
    "CTRL + SUPER + Backslash",
    "SUPER + Equal",
    "SUPER + BracketLeft",
    "SUPER + BracketRight",
    "CTRL + SUPER + BracketLeft",
    "CTRL + SUPER + BracketRight",
]

TR_TWINS = """\
hl.bind("SUPER + SHIFT + 7", hl.dsp.global("quickshell:cheatsheetToggle"), { description = "Shell: Toggle cheatsheet" })
hl.bind("SHIFT + SUPER + ALT + 7", hl.dsp.exec_cmd("qs -p $HOME/.config/quickshell/$qsConfig/welcome.qml"))
hl.bind("SUPER + SHIFT + comma", hl.dsp.layout("splitratio -0.1"), { repeating = true })
hl.bind("SUPER + SHIFT + 2", hl.dsp.layout("splitratio +0.1"), { repeating = true })
hl.bind("CTRL + SUPER + MOD5 + asterisk", hl.dsp.window.resize({ x = 640, y = 480, "exact" }), { description = "Window: Set size 640x480" })
hl.bind("SUPER + SHIFT + 0", function()
    local zoomvalue = hl.get_config("cursor:zoom_factor")
    if (zoomvalue + 0.3) > 3.0 then
        hl.config({ cursor = { zoom_factor = 3.0 } })
    elseif (zoomvalue + 0.3) < 1.0 then
        hl.config({ cursor = { zoom_factor = 1.0 } })
    else
        hl.config({ cursor = { zoom_factor = zoomvalue + 0.3 } })
    end
end, { repeating = true, description = "Screen: Zoom in" })
hl.bind("SUPER + MOD5 + 8", hl.dsp.focus({ direction = "l" }), { description = "Window: Focus left (brackets)" })
hl.bind("SUPER + MOD5 + 9", hl.dsp.focus({ direction = "r" }), { description = "Window: Focus right (brackets)" })
hl.bind("CTRL + SUPER + MOD5 + 8", hl.dsp.focus({ workspace = "-1" }), { description = "Workspace: Focus left (brackets)" })
hl.bind("CTRL + SUPER + MOD5 + 9", hl.dsp.focus({ workspace = "+1" }), { description = "Workspace: Focus right (brackets)" })
"""


def render(intent):
    lines = [
        MARKER,
        f"-- source: {json.dumps(intent, sort_keys=True)}",
        "",
        "hl.config({",
        "    input = {",
        f'        kb_layout = "{lua_escape(intent["layout"])}",',
        f'        kb_variant = "{lua_escape(intent["variant"])}",',
        f'        kb_options = "{lua_escape(intent["options"])}",',
        "    },",
        "})",
    ]
    if intent["layout"] == "tr" and not intent["variant"]:
        lines += [""]
        lines += [f'hl.unbind("{key}")' for key in TR_UNBINDS]
        lines += ["", TR_TWINS.rstrip("\n")]
    lines.append("")
    return "\n".join(lines)


def is_ours(path):
    try:
        with open(path, "r", encoding="utf-8") as handle:
            return handle.readline().strip() == MARKER
    except OSError:
        return False


def check_state(intent, problem):
    if problem:
        return 2, problem
    if intent is None:
        return 2, problem
    path = output_path()
    if not intent["layout"]:
        if os.path.exists(path) and is_ours(path):
            return 1, "generated file present without intent"
        return 0, "no intent, no generated file"
    try:
        with open(path, "r", encoding="utf-8") as handle:
            current = handle.read()
    except OSError:
        return 1, "generated file missing"
    if current != render(intent):
        return 1, "generated file stale"
    return 0, "generated file in sync"


def apply_state(intent, problem):
    if problem or intent is None:
        return fail(problem or "no intent readable")
    path = output_path()
    if not intent["layout"]:
        if os.path.exists(path):
            if not is_ours(path):
                return fail(f"refusing to remove hand-made {path}")
            os.remove(path)
            print("removed generated file (no intent)")
        else:
            print("no intent, nothing to do")
        return 0
    content = render(intent)
    if os.path.exists(path):
        if not is_ours(path):
            return fail(f"refusing to overwrite hand-made {path}")
        with open(path, "r", encoding="utf-8") as handle:
            if handle.read() == content:
                print("generated file already in sync")
                return 0
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with tempfile.NamedTemporaryFile(mode="w", dir=os.path.dirname(path), delete=False) as tmp:
        tmp.write(content)
        tmp_path = tmp.name
    os.chmod(tmp_path, 0o644)
    os.replace(tmp_path, path)
    print(f"wrote {path}")
    return 0


def main(argv):
    parser = argparse.ArgumentParser(description="Apply keyboard layout intent to Hyprland.")
    parser.add_argument("--apply", action="store_true", help="write/remove generated file to match intent")
    parser.add_argument("--check", action="store_true", help="exit 0 in sync, 1 stale/missing, 2 invalid")
    parser.add_argument("--layout", default=None, help="use this layout instead of the file value")
    parser.add_argument("--variant", default=None, help="use this variant instead of the file value")
    parser.add_argument("--options", default=None, help="use this options instead of the file value")
    args = parser.parse_args(argv)
    overrides = {"layout": args.layout, "variant": args.variant, "options": args.options}
    has_overrides = any(v is not None for v in overrides.values())
    intent, problem = read_intent(overrides if has_overrides else None)
    if problem and intent is not None:
        return fail(problem)
    if intent is not None:
        problem = validate(intent)
    if args.check:
        if has_overrides:
            if problem or intent is None:
                return fail(problem or "no intent readable")
            print(f"valid: {intent['layout']!r}")
            return 0
        code, message = check_state(intent, problem)
        print(message)
        return code
    return apply_state(intent, problem)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
